# Cabeceras HTTP de Cloudflare Pages (sustituyen a la sección «headers» del vercel.json de
# la plataforma). Formato: una ruta y, debajo, sus cabeceras con dos espacios delante.
# No se aplican a las funciones de functions/api/ (cada una pone las suyas).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/img/*
  Cache-Control: public, max-age=604800

/vendor/*
  Cache-Control: public, max-age=604800

/img/*.svg
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src data:; sandbox
  Content-Disposition: inline

/admin/*
  X-Robots-Tag: noindex, nofollow
